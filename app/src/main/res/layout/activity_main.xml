<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    tools:context=".activity.MainActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">



        <com.google.android.material.appbar.MaterialToolbar

            android:id="@+id/tool_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:outlineAmbientShadowColor="@color/md_theme_scrim"
            android:background="@color/card_bg"
            app:navigationIconTint="@color/text_primary"
            app:navigationIcon="@drawable/menu_24px">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:text="JUPITER"
                    android:layout_marginTop="5dp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="30dp"
                    android:textColor="@color/text_primary"/>

                <ImageView
                    android:id="@+id/main_call"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/baseline_add_ic_call_24"
                    android:backgroundTint="@color/text_primary"
                    android:layout_marginTop="15dp"/>

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:id="@+id/main_notification"
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:background="@drawable/outline_circle_notifications_24"
                        android:contentDescription="Notifications" />

                    <View
                        android:id="@+id/notification_badge_dot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/bg_notification_badge_red"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>






        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">



        </androidx.fragment.app.FragmentContainerView>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_view"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            app:itemPaddingTop="25dp"
            app:menu="@menu/bottom_nav_menu"
            app:itemIconTint="@color/accent_yellow"
            app:itemTextAppearanceInactive="@color/md_theme_primaryFixed_highContrast"
            android:background="@color/card_bg"
            app:labelVisibilityMode="labeled"
            app:itemTextColor="@color/accent_yellow"
            />


    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/side_navigation_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:itemTextColor="@color/accent_yellow"
        android:layout_gravity="start"
        app:menu="@menu/side_nav_menu"
        app:headerLayout="@layout/side_nav_header"
        app:itemIconTint="@color/accent_yellow"
        android:background="@color/card_bg"


        />



</androidx.drawerlayout.widget.DrawerLayout>