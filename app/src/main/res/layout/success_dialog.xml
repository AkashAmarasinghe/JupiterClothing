<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="270dp"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:id="@+id/successlinearLayout">

    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="270dp"
        android:id="@+id/layoutDialog"
        android:layout_marginTop="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:backgroundTint="@color/card_bg"
        android:background="@drawable/coustome_bkg">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SUCCESS!!"
            android:id="@+id/successTitle"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:textSize="25dp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/md_theme_success_green"/>
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:id="@+id/successImage"
            android:src="@drawable/success"/>

        <TextView
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="Operation Completed Successfully."
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:textSize="15dp"
            android:id="@+id/successDesc"
android:layout_marginTop="15dp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_regular"
            android:layout_gravity="center"/>

        <Button
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:text="CONFIRM"
            android:id="@+id/successDone"
            android:backgroundTint="@color/md_theme_success_green"
            android:layout_marginTop="5dp"
            android:textStyle="bold"/>


    </LinearLayout>

</LinearLayout>