<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_bg"
    android:padding="30dp"
    tools:context=".activity.SignUpActivity">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/poppins_bold"
        android:paddingStart="12dp"
        android:text="Join JUPITER"
        android:textAlignment="textStart"
        android:textColor="@color/text_primary"
        android:textSize="35dp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:paddingStart="12dp"
        android:text="Create Account for personalized style."
        android:textAlignment="textStart"
        android:textColor="@color/text_secondary"
        android:textSize="12dp"
        android:textStyle="bold" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/poppins_medium"
            android:text="Full Name"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/sign_up_full_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:inputType="textPersonName"
            android:background="@drawable/coustom_input_search"
            android:paddingStart="10dp"
            android:textColor="@color/text_primary"
            android:paddingEnd="10dp"
            android:textColorHint="@color/text_secondary"
            android:hint="Enter Full Name"
            android:textSize="13dp"
            android:layout_marginTop="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="10dp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/sign_up_email"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/coustom_input_search"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"

            android:textColorHint="@color/text_secondary"
            android:inputType="textEmailAddress"
            android:hint="Enter Valid Email"
            android:textColor="@color/text_primary"
            android:textSize="13dp"
            android:layout_marginTop="5dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Password"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_medium"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/poppins_medium"
                android:text="Confirm Password"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/sign_up_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/coustom_input_search"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="2dp"
                android:textColorHint="@color/text_secondary"
                android:inputType="textVisiblePassword"
                android:layout_weight="1"
                android:hint="Enter Password"
                android:textSize="13dp"
                android:layout_marginTop="5dp"/>


            <EditText

                android:id="@+id/sign_up_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/coustom_input_search"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_primary"
                android:inputType="textVisiblePassword"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:textColorHint="@color/text_secondary"
                android:hint="Confirm your Password"
                android:textSize="13dp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>



        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Mobile Number"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/sign_up_mobile"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:inputType="textPhonetic"
            android:background="@drawable/coustom_input_search"
            android:paddingStart="10dp"
            android:textColor="@color/text_primary"
            android:paddingEnd="10dp"
            android:textColorHint="@color/text_secondary"
            android:hint="Enter Mobile Number"
            android:textSize="13dp"
            android:layout_marginTop="5dp"/>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_up_sign_up_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/md_theme_scrim"
            android:backgroundTint="@color/text_primary"
            android:layout_marginTop="40dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_up_sign_in_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/md_theme_primary_mediumContrast"
            android:text="Allready Have Registered? Sign In"
            android:backgroundTint="@color/md_theme_scrim"
            android:layout_marginTop="10dp"/>
    </LinearLayout>





</LinearLayout>